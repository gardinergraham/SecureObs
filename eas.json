{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "demo": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "demo",
        "EXPO_PUBLIC_API_URL": "https://adequate-energy-demo.up.railway.app",
        "EXPO_PUBLIC_RELEASE_MANIFEST_URL": "https://secure-obs.com/demo-downloads/release.json"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
