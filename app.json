{
  "expo": {
    "name": "Secure Obs",
    "slug": "secureobs",
    "version": "0.1.9",
    "icon": "./assets/SecureObs.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "geckostudios.SecureSolutions"
    },
    "android": {
      "package": "com.geckostudios.secureobs",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "react-native-nfc-manager",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SecureObs to select authorised organisation logos and patient identification photographs.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SecureObs to scan authorised patient and room QR identification tags.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "",
      "eas": {
        "projectId": "3a264172-0d73-4056-9140-2340a37741f7"
      }
    }
  }
}
